{
  "name": "vellum",
  "version": "0.1.1-beta.1",
  "description": "Vellum — local-first AI paper workspace that runs on your own Claude/Codex plan via ACP. No extra API key.",
  "author": "Kritarth Dandapat",
  "license": "MIT",
  "homepage": "https://github.com/dkritarth/Vellum",
  "main": "out/main/index.cjs",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && node test/offline-gates.mjs",
    "smoke:acp": "tsx core/acp/smoke.ts",
    "test:gate:reading": "node test/reading-gate.mjs",
    "test:gate:collections": "node test/collections-live.mjs",
    "test:gate:chats": "node test/chats-live.mjs",
    "test:gate:questions": "node test/questions-live.mjs",
    "test:gate:trash": "node test/trash-live.mjs",
    "test:gate:usage": "node test/usage-live.mjs",
    "dist": "electron-vite build && electron-builder --linux --publish never",
    "dist:mac": "electron-vite build && electron-builder --mac --arm64 --publish never",
    "test:gate:reader": "node test/reader-gate.mjs",
    "test:gate:reader-scroll-zoom": "node test/reader-scroll-zoom-gate.mjs",
    "test:gate:app-ux": "node test/app-ux-live.mjs",
    "demo:record": "node test/walkthrough-live.mjs",
    "site:build": "node scripts/build-website.mjs"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.2.1",
    "better-sqlite3": "13.2.0",
    "pdfjs-dist": "6.2.108",
    "unpdf": "^1.6.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "45.3.3",
    "electron-builder": "26.18.0",
    "electron-vite": "^6.0.0",
    "jsdom": "^25.0.1",
    "playwright": "^1.63.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "tsx": "^4.23.1",
    "typescript": "^5.6.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "app-builder-lib": {
      "minimatch@^10.2.5": "11.0.9"
    },
    "@electron/universal": {
      "minimatch@^9.0.3": "11.0.9"
    }
  },
  "//": "ACP uses the canonical @agentclientprotocol/sdk. better-sqlite3 13 uses N-API prebuilds shared by Node and Electron. Packaging copies the target-platform prebuild to resources/native; the checked-in Linux development binding matches the pinned package version.",
  "allowScripts": {
    "electron@45.3.3": true,
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true
  }
}
